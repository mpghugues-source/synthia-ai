# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=https://synthia.yourdomain.com

# ── AI Backends (local) ────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
XTTS_URL=http://127.0.0.1:8020
MUSICGEN_SCRIPT=/var/www/synthia-ai/scripts/musicgen_generate.py
PYTHON_BIN=/usr/bin/python3

# ── Storage paths ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/www/synthia-ai/uploads
STOCK_CLIPS_DIR=/var/www/synthia-ai/stock
OUTPUT_DIR=/var/www/synthia-ai/output
VOICE_SAMPLES_DIR=/var/www/synthia-ai/voice-samples

# ── Flutterwave ────────────────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash

# ── YouTube Data API v3 ────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── TikTok Creator API ─────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Instagram / Facebook Graph API ────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── X (Twitter) v2 ────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
